[Unit]
Description=МедАрхив — система управления архивом медицинских карт
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=medarchive
Group=medarchive
WorkingDirectory=/opt/medarchive
EnvironmentFile=/etc/medarchive/medarchive.env
Environment=MEDARCHIVE_POSTGRES_ENABLED=true
Environment=MEDARCHIVE_AUTH_BACKEND=postgresql
UMask=0077
ExecStart=/opt/medarchive/.venv/bin/uvicorn medarchive.main:create_app --factory --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Service hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/medarchive

[Install]
WantedBy=multi-user.target
