[Unit]
Description=МедАрхив — система управления архивом медицинских карт
After=network.target

[Service]
Type=simple
User=medarchive
Group=medarchive
WorkingDirectory=/opt/medarchive
Environment=MEDARCHIVE_SECRET_KEY=CHANGE_ME
Environment=MEDARCHIVE_DB_PATH=/var/lib/medarchive/medarchive.db
ExecStart=/opt/medarchive/.venv/bin/uvicorn medarchive.main:create_app --factory --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Безопасность
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
